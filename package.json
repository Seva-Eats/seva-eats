{
  "name": "seva-eats",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:iphone17": "xcrun simctl boot 6DCB7D91-F046-4CAA-8FC8-95B162E6C3BE || true && open -a Simulator || true && npx expo run:ios --udid 6DCB7D91-F046-4CAA-8FC8-95B162E6C3BE",
    "run-ios:iphone17": "xcrun simctl boot 6DCB7D91-F046-4CAA-8FC8-95B162E6C3BE || true && open -a Simulator || true && npx react-native run-ios --udid 6DCB7D91-F046-4CAA-8FC8-95B162E6C3BE",
    "web": "expo start --web",
    "lint": "expo lint",
    "prebuild": "expo prebuild --clean",
    "build:ios": "npm run prebuild && xcodebuild -workspace ios/SevaEats.xcworkspace -scheme SevaEats -configuration Release -derivedDataPath ios/build",
    "build:ios:sim": "npm run prebuild && xcodebuild -workspace ios/SevaEats.xcworkspace -scheme SevaEats -sdk iphonesimulator -configuration Debug -derivedDataPath ios/build"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.104.1",
    "expo": "^55.0.18",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.14",
    "expo-location": "~55.1.8",
    "expo-notifications": "~55.0.20",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "^55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-is": "^19.2.5",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.7.4"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
